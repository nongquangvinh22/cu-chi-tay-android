<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐIỀU KHIỂN THÔNG MINH"
            android:textColor="#67E8F9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Cử Chỉ Tay"
            android:textColor="#F8FAFC"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Bản quyền của Nông Quang Vinh"
            android:textColor="#A5C2D8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Điều khiển điện thoại bằng bàn tay trước camera. Không cần chạm vào màn hình."
            android:textColor="#C5D5E5"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  ·  THIẾT LẬP QUYỀN"
                android:textColor="#7DD3FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Quyền camera"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCam"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#0284C7"
                android:text="Cấp quyền camera và thông báo"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#334B647A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dịch vụ Trợ năng"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvA11y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnA11y"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#24506A"
                android:text="Mở cài đặt Trợ năng"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnAppInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:backgroundTint="#24364B"
                android:text="Mở thông tin ứng dụng nếu nút Trợ năng bị mờ"
                android:textColor="#DCEAF5"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02  ·  ĐIỀU KHIỂN"
                android:textColor="#7DD3FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bật để bắt đầu nhận diện bàn tay qua camera trước."
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#059669"
                android:text="BẬT ĐIỀU KHIỂN BẰNG CỬ CHỈ"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="03  ·  TÙY CHỈNH CỬ CHỈ"
                android:textColor="#7DD3FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swSwipeUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="#38BDF8"
                android:text="Hất tay lên để cuộn lên"
                android:textColor="#F1F5F9"
                android:thumbTint="#67E8F9"
                android:trackTint="#52738A" />

            <Switch
                android:id="@+id/swSwipeDown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="#38BDF8"
                android:text="Hất tay xuống để cuộn xuống"
                android:textColor="#F1F5F9"
                android:thumbTint="#67E8F9"
                android:trackTint="#52738A" />

            <Switch
                android:id="@+id/swSwipeLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="#38BDF8"
                android:text="Hất tay sang trái"
                android:textColor="#F1F5F9"
                android:thumbTint="#67E8F9"
                android:trackTint="#52738A" />

            <Switch
                android:id="@+id/swSwipeRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="#38BDF8"
                android:text="Hất tay sang phải"
                android:textColor="#F1F5F9"
                android:thumbTint="#67E8F9"
                android:trackTint="#52738A" />

            <Switch
                android:id="@+id/swGrab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="#38BDF8"
                android:text="Xòe tay rồi nắm lại để chụp màn hình"
                android:textColor="#F1F5F9"
                android:thumbTint="#67E8F9"
                android:trackTint="#52738A" />

            <Switch
                android:id="@+id/swInvert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="#38BDF8"
                android:text="Đảo chiều cuộn lên / xuống"
                android:textColor="#F1F5F9"
                android:thumbTint="#67E8F9"
                android:trackTint="#52738A" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="#334B647A" />

            <TextView
                android:id="@+id/tvSens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekSens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressBackgroundTint="#53677D"
                android:progressTint="#38BDF8"
                android:thumbTint="#7DD3FC" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nhạy hơn giúp bắt cử chỉ dễ hơn; giảm xuống nếu app nhận nhầm khi tay đang đứng yên."
                android:textColor="#AFC2D5"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="67"
                android:progressBackgroundTint="#53677D"
                android:progressTint="#34D399"
                android:thumbTint="#6EE7B7" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kéo sang phải để vuốt nhanh hơn; kéo sang trái để cuộn chậm và mượt hơn."
                android:textColor="#AFC2D5"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MẸO SỬ DỤNG"
                android:textColor="#7DD3FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="4dp"
                android:text="• Đặt điện thoại thẳng đứng, để camera trước nhìn rõ bàn tay ở khoảng 25–50 cm và nơi đủ sáng.\n• Hất tay theo hướng đã bật công tắc tương ứng.\n• Chụp màn hình: xòe tay rồi nắm lại.\n• Sau mỗi lần hất, đưa tay về từ từ hoặc ra khỏi khung hình để tránh nhận nhầm chuyển động ngược.\n• Muốn dừng, bấm nút TẮT trong ứng dụng hoặc trên thông báo.\n\nTrên vivo: đặt mức dùng pin nền của Cử Chỉ Tay thành Không hạn chế để giảm nguy cơ hệ thống dừng dịch vụ."
                android:textColor="#D5E2EE"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Bản quyền của Nông Quang Vinh"
            android:textColor="#A5C2D8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="CỬ CHỈ TAY  ·  SMART HAND CONTROL"
            android:textColor="#66869F"
            android:textSize="10sp"
            android:letterSpacing="0.08" />

    </LinearLayout>
</ScrollView>
