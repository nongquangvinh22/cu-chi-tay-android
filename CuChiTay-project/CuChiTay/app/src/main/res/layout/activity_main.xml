<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="NQV  ·  SMART CONTROL"
                android:textColor="#BDEEFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERSION 2.0"
                android:textColor="#83A8C9"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.09" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="ĐIỀU KHIỂN THÔNG MINH"
            android:textColor="#83E9FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.17" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Cử Chỉ Tay"
            android:textColor="#F7FBFF"
            android:textSize="38sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Bản quyền của Nông Quang Vinh"
            android:textColor="#9FC5E1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="18dp"
            android:text="Điều khiển điện thoại bằng bàn tay trước camera. Không cần chạm vào màn hình."
            android:textColor="#BDCCDD"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_action_card"
            android:elevation="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="17dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_icon_badge"
                android:gravity="center"
                android:text="✋"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Điều khiển không chạm"
                    android:textColor="#F7FCFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nhận diện bàn tay bằng AI ngay trên thiết bị"
                    android:textColor="#C7DCEE"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="●  CAMERA AI  ·  XỬ LÝ TẠI CHỖ"
                    android:textColor="#8DE7D2"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.07" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="11dp"
            android:text="01  /  QUYỀN TRUY CẬP"
            android:textColor="#9BC8E8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_badge"
                    android:gravity="center"
                    android:text="◎"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Camera trước"
                        android:textColor="#F4F9FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Dùng để nhận diện chuyển động bàn tay"
                        android:textColor="#9FB8CE"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvCam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_status_chip"
                android:padding="10dp"
                android:textColor="#D7E9F7"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCam"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:text="Cấp quyền camera và thông báo"
                android:textAllCaps="false"
                android:textColor="#F2FAFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#28D9F3FF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_badge"
                    android:gravity="center"
                    android:text="⌘"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dịch vụ Trợ năng"
                        android:textColor="#F4F9FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Thực hiện thao tác vuốt và chụp màn hình"
                        android:textColor="#9FB8CE"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvA11y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_status_chip"
                android:padding="10dp"
                android:textColor="#D7E9F7"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnA11y"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:text="Mở cài đặt Trợ năng"
                android:textAllCaps="false"
                android:textColor="#F2FAFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAppInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:minHeight="42dp"
                android:text="Thông tin ứng dụng và quyền hệ thống"
                android:textAllCaps="false"
                android:textColor="#C5D8E8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="11dp"
            android:text="02  /  ĐIỀU KHIỂN TRUNG TÂM"
            android:textColor="#9BC8E8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_action_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sẵn sàng điều khiển?"
                android:textColor="#F7FCFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="13dp"
                android:text="Bật chế độ nhận diện để sử dụng các cử chỉ đã chọn trong ứng dụng khác."
                android:textColor="#BDD2E4"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:text="BẬT ĐIỀU KHIỂN BẰNG CỬ CHỈ"
                android:textAllCaps="false"
                android:textColor="#08233B"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="6dp"
            android:text="03  /  CÁ NHÂN HÓA CỬ CHỈ"
            android:textColor="#9BC8E8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Mỗi công tắc hoạt động độc lập. Chỉ bật những thao tác bạn muốn sử dụng."
            android:textColor="#9EB5CB"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <!-- Swipe up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_glass_row"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_badge"
                android:gravity="center"
                android:text="↑"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hất tay lên"
                    android:textColor="#F3F8FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Cuộn nội dung lên trên"
                    android:textColor="#9FB8CE"
                    android:textSize="11sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swSwipeUp"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="58dp"
                android:showText="false"
                android:text=""
                android:thumb="@drawable/liquid_switch_thumb"
                android:track="@drawable/liquid_switch_track"
                android:splitTrack="false"
                android:contentDescription="Bật hoặc tắt hất tay lên để cuộn lên" />
        </LinearLayout>

        <!-- Swipe down -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_glass_row"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_badge"
                android:gravity="center"
                android:text="↓"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hất tay xuống"
                    android:textColor="#F3F8FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Cuộn nội dung xuống dưới"
                    android:textColor="#9FB8CE"
                    android:textSize="11sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swSwipeDown"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="58dp"
                android:showText="false"
                android:text=""
                android:thumb="@drawable/liquid_switch_thumb"
                android:track="@drawable/liquid_switch_track"
                android:splitTrack="false"
                android:contentDescription="Bật hoặc tắt hất tay xuống để cuộn xuống" />
        </LinearLayout>

        <!-- Swipe left -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_glass_row"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_badge"
                android:gravity="center"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hất tay sang trái"
                    android:textColor="#F3F8FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Thực hiện thao tác vuốt ngang trái"
                    android:textColor="#9FB8CE"
                    android:textSize="11sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swSwipeLeft"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="58dp"
                android:showText="false"
                android:text=""
                android:thumb="@drawable/liquid_switch_thumb"
                android:track="@drawable/liquid_switch_track"
                android:splitTrack="false"
                android:contentDescription="Bật hoặc tắt hất tay sang trái" />
        </LinearLayout>

        <!-- Swipe right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_glass_row"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_badge"
                android:gravity="center"
                android:text="→"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hất tay sang phải"
                    android:textColor="#F3F8FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Thực hiện thao tác vuốt ngang phải"
                    android:textColor="#9FB8CE"
                    android:textSize="11sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swSwipeRight"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="58dp"
                android:showText="false"
                android:text=""
                android:thumb="@drawable/liquid_switch_thumb"
                android:track="@drawable/liquid_switch_track"
                android:splitTrack="false"
                android:contentDescription="Bật hoặc tắt hất tay sang phải" />
        </LinearLayout>

        <!-- Grab to capture -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_glass_row"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_badge"
                android:gravity="center"
                android:text="⌗"
                android:textColor="#FFFFFF"
                android:textSize="23sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Xòe tay rồi nắm lại"
                    android:textColor="#F3F8FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Chụp ảnh màn hình bằng cử chỉ"
                    android:textColor="#9FB8CE"
                    android:textSize="11sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swGrab"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="58dp"
                android:showText="false"
                android:text=""
                android:thumb="@drawable/liquid_switch_thumb"
                android:track="@drawable/liquid_switch_track"
                android:splitTrack="false"
                android:contentDescription="Bật hoặc tắt chụp màn hình bằng cử chỉ nắm tay" />
        </LinearLayout>

        <!-- Invert -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_row"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_badge"
                android:gravity="center"
                android:text="⇅"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đảo chiều cuộn"
                    android:textColor="#F3F8FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Đổi hướng cuộn lên và xuống"
                    android:textColor="#9FB8CE"
                    android:textSize="11sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swInvert"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="58dp"
                android:showText="false"
                android:text=""
                android:thumb="@drawable/liquid_switch_thumb"
                android:track="@drawable/liquid_switch_track"
                android:splitTrack="false"
                android:contentDescription="Bật hoặc tắt đảo chiều cuộn" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="11dp"
            android:text="04  /  TINH CHỈNH NHẬN DIỆN"
            android:textColor="#9BC8E8"
