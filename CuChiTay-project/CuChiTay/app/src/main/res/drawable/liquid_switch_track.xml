<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="54dp" android:height="30dp" />
            <corners android:radius="18dp" />
            <gradient android:angle="0" android:startColor="#A65DDFFF" android:endColor="#885A8EFF" />
            <stroke android:width="1dp" android:color="#AFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="54dp" android:height="30dp" />
            <corners android:radius="18dp" />
            <gradient android:angle="0" android:startColor="#5CFFFFFF" android:endColor="#2AFFFFFF" />
            <stroke android:width="1dp" android:color="#70FFFFFF" />
        </shape>
    </item>
</selector>
