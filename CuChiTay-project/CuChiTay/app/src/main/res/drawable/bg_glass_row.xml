<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient android:angle="315" android:startColor="#3D65A1C9" android:endColor="#234A85B7" />
            <stroke android:width="1dp" android:color="#83C5F4FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient android:angle="315" android:startColor="#27FFFFFF" android:endColor="#13A5C7E8" />
            <stroke android:width="1dp" android:color="#36FFFFFF" />
        </shape>
    </item>
</selector>
