<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <size android:width="25dp" android:height="25dp" />
            <gradient android:angle="315" android:startColor="#FFFFFF" android:centerColor="#E4FAFF" android:endColor="#A8E7FF" />
            <stroke android:width="1dp" android:color="#DFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="25dp" android:height="25dp" />
            <gradient android:angle="315" android:startColor="#F9FCFF" android:centerColor="#E3ECF5" android:endColor="#B8CBE0" />
            <stroke android:width="1dp" android:color="#BFFFFFFF" />
        </shape>
    </item>
</selector>
